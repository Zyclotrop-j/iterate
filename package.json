{
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "barecolor": "^1.0.1",
    "baretest": "^2.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  },
  "name": "iterate-async",
  "version": "1.4.0",
  "engines": {
    "node": ">=18"
  },
  "main": "build/index",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "require": "./build/index.cjs",
      "import": "./build/index.mjs"
    }
  },
  "files": [
    "build/"
  ],
  "scripts": {
    "test:compile": "esbuild src/index.ts --bundle --format=esm --outfile=src/index.mjs && esbuild src/isConstructable.ts --format=esm --outfile=src/isConstructable.mjs && esbuild src/isIterable.ts --format=esm --outfile=src/isIterable.mjs && esbuild src/getLength.ts --format=esm --outfile=src/getLength.mjs && esbuild src/tryGetIn.ts --format=esm --outfile=src/tryGetIn.mjs",
    "test:clean": "rm -f src/index.mjs src/isConstructable.mjs src/isIterable.mjs src/getLength.mjs src/tryGetIn.mjs",
    "test": "yarn test:compile && node test.mjs; CODE=$?; yarn test:clean; exit $CODE",
    "coverage": "c8 -r lcov -r text --report-dir ./.c8-report yarn test",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --sourcemap --outfile=build/index.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --sourcemap --outfile=build/index.cjs",
    "build:global": "esbuild src/index.ts --bundle --format=iife --global-name=ProcessConcurrently --sourcemap --outfile=build/index.js",
    "build:types": "tsc --project tsconfig.json",
    "build": "yarn build:esm && yarn build:cjs && yarn build:global && yarn build:types",
    "semantic-release": "npx semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zyclotrop-j/iterate.git"
  },
  "author": "Jannes Mingram <jannes@mingram.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zyclotrop-j/iterate/issues"
  },
  "homepage": "https://github.com/Zyclotrop-j/iterate#readme",
  "description": "Like `await Promise.all(mytasks.map(async (item) => ....))`, but with super-powers",
  "keywords": [
    "async",
    "iterator",
    "map",
    "reduce",
    "array",
    "object",
    "each",
    "iterable",
    "promise",
    "pool",
    "batch"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "tarballDir": "dist"
        }
      ],
      "@semantic-release/git"
    ]
  }
}
